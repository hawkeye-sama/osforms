# OSForms Docker config. Copy this file to .env, then edit:
#
#   cp .env.docker.example .env
#
# docker-compose.yml loads this via env_file, so these values become the web
# container's environment. .env is gitignored, so your secrets stay local.

# ── Required ────────────────────────────────────────────────────────────────

# Public URL the browser uses. Baked into the client bundle at build time, so
# after changing it, rebuild: `docker compose up --build`.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generate each of these with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ENCRYPTION_KEY must be exactly 64 hex characters. Do NOT change it once you
# have live data — stored integration keys become undecryptable.
JWT_SECRET=
ENCRYPTION_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# Database. Defaults to the bundled mongo service, so leave this unset unless
# you want to point at an external MongoDB (e.g. Atlas).
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/osforms

# System emails (OTP, welcome, failure alerts). The Resend email integration
# uses each user's own key, not this one. System emails come from hardcoded
# @osforms.com addresses, so they won't be delivered from your instance yet,
# and without a key signup returns a 500 (the account is still saved). The OTP
# is never logged. Read it from MongoDB:
#   docker compose exec mongodb mongosh osforms --eval 'db.emailverifications.find().sort({createdAt:-1}).limit(1)'
# then enter it at /verify-email?email=<your email>.
RESEND_API_KEY=

# Google Sheets integration (Google OAuth). Leave blank to disable.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only used by osforms.com's inbound email forwarding. Leave blank.
RESEND_EMAIL_SIGNING_SECRET=

# Signup spam protection (Google reCAPTCHA v3). Set both or neither. The site
# key is baked in at build time, so rebuild after changing it.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# RECAPTCHA_MIN_SCORE=0.5
