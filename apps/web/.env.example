# ─────────────────────────────────────────────────────────────────────────────
# OSForms — environment variables
#
# Copy this file to `.env` in the SAME directory (apps/web), then fill it in:
#   cp apps/web/.env.example apps/web/.env
# ─────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# MongoDB connection string.
#   Local Docker (docker compose up -d mongodb):  mongodb://localhost:27017/osforms
#   MongoDB Atlas:                                 mongodb+srv://<user>:<pass>@<cluster>/osforms
MONGODB_URI=mongodb://localhost:27017/osforms

# Secret used to sign auth JWTs. Any long random string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-string

# AES-256 key for encrypting user API keys at rest. EXACTLY 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Public URL of this app. Used for the Google OAuth callback, form endpoint URLs
# shown in the dashboard, links in system emails, and canonical/sitemap URLs.
# (CORS is configured per form, not here.)
#   Local:      http://localhost:3000
#   Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Optional: Google Sheets integration (Google OAuth) ───────────────────────
# Create OAuth credentials at https://console.cloud.google.com
# (APIs & Services → Credentials → OAuth client ID → Web application).
# Authorized redirect URI MUST be exactly:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Optional: signup spam protection (Google reCAPTCHA v3) ───────────────────
# Create a v3 ("score based") key at https://www.google.com/recaptcha/admin/create
# and add your domains (plus `localhost` if you want it on in dev).
# Signup CAPTCHA is enabled when RECAPTCHA_SECRET_KEY is set. Set BOTH keys or
# neither: a secret without the site key rejects every signup.
# The site key is inlined into the client bundle at build time.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Minimum score (0.0 bot – 1.0 human) to allow a signup. Default 0.5.
# RECAPTCHA_MIN_SCORE=0.5

# ── Optional: email (Resend) ─────────────────────────────────────────────────
# API key from https://resend.com/api-keys. System emails ONLY (OTP / verification,
# welcome, integration-failure alerts). The Resend email integration uses the key
# each user saves on the integration, not this one.
# Note: system emails are sent from hardcoded @osforms.com addresses, so a
# self-hosted instance can't deliver them yet, even with a key. Without a key,
# signup returns a 500 (the account is still saved). The OTP is never logged;
# read it from MongoDB. See SELF_HOSTING.md "Verify your account without email".
RESEND_API_KEY=

# Only used by osforms.com's inbound email forwarding. Leave blank when self-hosting.
RESEND_EMAIL_SIGNING_SECRET=
